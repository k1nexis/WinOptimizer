<Window x:Class="WinOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOptimizer" Height="760" Width="1120" MinHeight="650" MinWidth="900" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="WINOPTIMIZER" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="OsText" Text="Выберите версию Windows" Foreground="#9CA8B8" Margin="0,4"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="OsCombo" Width="190" Margin="4" SelectionChanged="OsCombo_SelectionChanged"><ComboBoxItem Content="Автоопределение" IsSelected="True"/><ComboBoxItem Content="Windows 7"/><ComboBoxItem Content="Windows 8 / 8.1"/><ComboBoxItem Content="Windows 10"/><ComboBoxItem Content="Windows 11"/></ComboBox><Button Content="Определить автоматически" Click="DetectOs_Click"/></StackPanel></DockPanel>
  <TabControl Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Bg}" Foreground="#E6EAF0" BorderBrush="#29313D"><TabItem Header="Профили оптимизации"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel x:Name="ProfileButtons"><Button Content="Игры" Tag="Games" Click="Profile_Click"/><Button Content="Старый ПК и ноутбук" Tag="OldPc" Click="Profile_Click"/><Button Content="Монтаж и рендеринг" Tag="Media" Click="Profile_Click"/><Button Content="Работа и учёба" Tag="Work" Click="Profile_Click"/><TextBlock Text="Перед системными изменениями создайте точку восстановления." TextWrapping="Wrap" Foreground="#9CA8B8" Margin="8,24"/></StackPanel><DockPanel Grid.Column="1" Margin="18,0,0,0"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12"><Button Content="Создать точку восстановления" Background="#394454" Click="Restore_Click"/><Button Content="Открыть настройки защиты" Background="#394454" Click="OpenProtection_Click"/><Button Content="Включить защиту системы" Click="EnableProtection_Click"/><Button Content="Применить отмеченное" Click="Apply_Click"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ProfileTitle" Text="Выберите профиль" FontSize="21" FontWeight="SemiBold" Margin="8,0,8,10"/><ItemsControl x:Name="TweaksList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></DockPanel></Grid></TabItem>
   <TabItem Header="Восстановление"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Точки восстановления Windows — это локальные снимки системных настроек, а не резервная копия личных файлов." TextWrapping="Wrap" Foreground="#C4CDD9" Margin="8,4,8,12"/><StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="Открыть настройки защиты" Click="OpenProtection_Click"/><Button Content="Включить защиту системы" Click="EnableProtection_Click"/><Button Content="Создать точку восстановления" Click="Restore_Click"/></StackPanel><TextBlock Grid.Row="2" Text="Место хранения точек для системного диска можно перенести на другой локальный диск. Windows хранит их в служебной области VSS, а не в выбранной папке. При переносе старые точки могут быть удалены." TextWrapping="Wrap" Foreground="#9CA8B8" Margin="8,14,8,8"/><StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Диск хранения:" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="RestoreStorageDriveCombo" Width="180" Margin="4"/><TextBlock Text="Лимит (ГБ):" VerticalAlignment="Center" Margin="12,4,4,4"/><TextBox x:Name="RestoreStorageSizeText" Width="70" Text="10" VerticalContentAlignment="Center" Margin="4"/><Button Content="Применить место хранения" Click="ApplyRestoreStorage_Click"/></StackPanel><TextBlock Grid.Row="4" Text="Изменение ассоциации VSS может удалить существующие точки восстановления. Выбранный диск должен быть локальным и иметь свободное место. Настройка требует прав администратора." TextWrapping="Wrap" Foreground="#E0B35A" Margin="8,10"/><TextBlock x:Name="ProtectionStatusText" Grid.Row="5" TextWrapping="Wrap" Foreground="#9CA8B8" Margin="8,8"/></Grid></TabItem>
   <TabItem Header="Установка программ"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><TextBlock Text="Папка установки:" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="DriveCombo" Width="430" Margin="6"/><Button Content="Обзор…" Click="Browse_Click"/></DockPanel><StackPanel Grid.Row="1" Margin="0,2,0,8"><DockPanel><Button x:Name="DriverButton" DockPanel.Dock="Right" Content="Скачать доступные драйверы" Click="Drivers_Click"/><TextBlock x:Name="GpuText" Text="Видеокарта: определение…" Foreground="#9CA8B8" Margin="8" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Профиль оптимизации автоматически отмечает подходящие программы; отметки можно изменить вручную." FontSize="11" Foreground="#8895A5" Margin="8,0" TextWrapping="Wrap"/><TextBlock Text="Драйверы ищутся через настроенный Windows Update и скачиваются, но не устанавливаются автоматически. В VM это будут драйверы виртуальных устройств." FontSize="11" Foreground="#8895A5" Margin="8,3,8,0" TextWrapping="Wrap"/></StackPanel><ScrollViewer Grid.Row="2"><ItemsControl x:Name="SoftwareList"><ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource LocalizedTextConverter}}" FontSize="15" FontWeight="SemiBold" Foreground="#69A7FF" Margin="8,14,4,4"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" ToolTip="{Binding CompatibilityNote}" Content="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Установить выбранное" Click="Install_Click"/></StackPanel><ProgressBar Grid.Row="4" x:Name="Progress" Height="10" Margin="8" Minimum="0" Maximum="100"/><TextBlock Grid.Row="5" x:Name="StatusText" Text="Готово" Margin="8" Foreground="#9CA8B8"/></Grid></TabItem>
   <TabItem Header="Оборудование и драйверы"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Комплектующие этого ПК. Поиск драйверов выполняется через настроенный Windows Update для обнаруженного оборудования; перед установкой просматривайте предлагаемые обновления." Foreground="#C4CDD9" TextWrapping="Wrap" Margin="8,4,8,12"/><TextBox x:Name="HardwareText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#161D27" Foreground="#E6EAF0" BorderBrush="#29313D" FontFamily="Consolas" FontSize="14" Padding="12"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12"><Button Content="Обновить сведения" Click="RefreshHardware_Click"/><Button Content="Диспетчер устройств" Background="#394454" Click="DeviceManager_Click"/><Button Content="Скачать подходящие драйверы" x:Name="HardwareDriverButton" Click="Drivers_Click"/></StackPanel></Grid></TabItem>
   <TabItem Header="Полная приватность"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Настройки уменьшают часть сбора данных и рекламы Windows. Полной анонимности они не обеспечивают; некоторые параметры зависят от редакции и версии Windows." TextWrapping="Wrap" Foreground="#C4CDD9" Margin="8,4,8,12"/><StackPanel Grid.Row="1"><TextBlock Text="Браузер для приватности" FontSize="17" FontWeight="SemiBold" Margin="8,4"/><ItemsControl x:Name="PrivacyBrowserList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" ToolTip="{Binding CompatibilityNote}" Content="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal"><Button Content="Установить выбранный браузер" Click="InstallPrivacyBrowser_Click"/><Button Content="Страница Tor Browser" Background="#394454" Click="TorDownload_Click"/></StackPanel><TextBlock Text="Mullvad Browser блокирует трекеры и помогает защищаться от цифрового отпечатка, но сам не скрывает IP. Tor Browser направляет трафик через сеть Tor. Не устанавливайте дополнительные расширения в Tor Browser и не входите в личные аккаунты, если нужна анонимность." TextWrapping="Wrap" Foreground="#9CA8B8" FontSize="11" Margin="8,4,8,10"/></StackPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Параметры Windows" FontSize="17" FontWeight="SemiBold" Margin="8,8,8,2"/><ItemsControl x:Name="PrivacyTweaksList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Открыть разрешения приложений" Background="#394454" Click="OpenPrivacySettings_Click"/><Button Content="Создать точку и применить" Click="ApplyPrivacy_Click"/></StackPanel></Grid></TabItem></TabControl>
  <TextBlock Grid.Row="3" Text="Изменения реестра и служб требуют прав администратора. Перед применением убедитесь, что выбранные параметры подходят вашей системе." Foreground="#8490A0" Margin="4,14,4,0"/>
 </Grid>
</Window>
